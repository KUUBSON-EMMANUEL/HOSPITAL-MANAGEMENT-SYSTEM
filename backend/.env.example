# Copy to `.env` and fill in real values. Never commit the real `.env` file.

DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=change-me-to-a-random-50-char-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DATABASE_URL=postgres://hms:hms@localhost:5432/hms

REDIS_URL=redis://localhost:6379/0

CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_BASE_URL=http://localhost:5173

HMS_MFA_ISSUER_NAME=HMS Hospital
HMS_PATIENT_ID_PREFIX=PT

ENABLE_DEBUG_TOOLBAR=False

# Production only
SENTRY_DSN=
USE_S3_STORAGE=False
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1
